# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
# The proxy's in-cluster address, from the edge to litellm. config/config.yaml joins them.
LITELLM_HOST=${dependency:litellm.host}
LITELLM_PORT=${dependency:litellm.port}

# One LiteLLM virtual key per tier. Names follow agent-kit registry/estate-tooling.yaml.
LITELLM_FREE_KEY=${secret:secret/data/hermes/hermes#litellm_free_key}
LITELLM_TIER_VIBE_KEY=${secret:secret/data/hermes/hermes#litellm_tier_vibe_key}
LITELLM_TIER_GO_CHEAP_KEY=${secret:secret/data/hermes/hermes#litellm_tier_go_cheap_key}
LITELLM_TIER_REVIEW_KEY=${secret:secret/data/hermes/hermes#litellm_tier_review_key}
LITELLM_TIER_STRONG_OPEN_KEY=${secret:secret/data/hermes/hermes#litellm_tier_strong_open_key}

# Optional: a fine-grained PAT for the public repositories a loop pushes to. git and gh read it.
GH_TOKEN=${secret:secret/data/hermes/hermes#github_pat}
