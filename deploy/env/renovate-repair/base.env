# The Process scope of renovate-repair (deploy-kit spec/v1, chapter 10, Configuration).
# The proxy's in-cluster address, from the edge to litellm. config/config.yaml joins them.
LITELLM_HOST=${dependency:litellm.host}
LITELLM_PORT=${dependency:litellm.port}

# One LiteLLM virtual key per tier the loop may use (tier-free, tier-vibe, tier-go-cheap; and
# tier-review, which the rendered config requires). No strong-open key: the loop never uses it.
LITELLM_FREE_KEY=${secret:secret/data/hermes/hermes#litellm_free_key}
LITELLM_TIER_VIBE_KEY=${secret:secret/data/hermes/hermes#litellm_tier_vibe_key}
LITELLM_TIER_GO_CHEAP_KEY=${secret:secret/data/hermes/hermes#litellm_tier_go_cheap_key}
LITELLM_TIER_REVIEW_KEY=${secret:secret/data/hermes/hermes#litellm_tier_review_key}

# Where the loop finds its modules, and the file that holds the GitHub token (delivered as a file by
# the grant of secret/data/hermes/github; the variable holds a path, never the token).
PYTHONPATH=/opt/hermes-seed
GITHUB_TOKEN_FILE=/run/secrets/github/token
